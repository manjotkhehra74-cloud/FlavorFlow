diff --git a/mobile/android/app/src/main/res/raw/keep.xml b/mobile/android/app/src/main/res/raw/keep.xml
new file mode 100644
index 0000000..8df4cb2
--- /dev/null
+++ b/mobile/android/app/src/main/res/raw/keep.xml
@@ -0,0 +1,5 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Release builds shrink resources; the push icon/colour are referenced by NAME from FCM
+     payloads and the manifest, so pin them explicitly. -->
+<resources xmlns:tools="http://schemas.android.com/tools"
+    tools:keep="@drawable/ic_notification,@color/hr_blue,@color/hr_navy" />
diff --git a/mobile/android/app/src/main/res/values-night/styles.xml b/mobile/android/app/src/main/res/values-night/styles.xml
