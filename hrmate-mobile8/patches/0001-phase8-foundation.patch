+        color: Colors.transparent,
+        child: InkWell(
+          borderRadius: BorderRadius.circular(HrBrand.radiusCard),
+          onTap: item.onTap,
+          child: KpiTile(label: item.label, value: item.value, sub: item.sub, bar: item.bar, color: item.color),
+        ),
+      );
+}
